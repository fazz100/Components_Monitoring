<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="Dg3.CommonLibraries.LogWriter" type="Dg3.CommonLibraries.LogWriterConfigReader,Dg3.CommonLibraries.LogWriter" />
	</configSections>
	<!-- LOG WRITER -->
	<Dg3.CommonLibraries.LogWriter>
		<log_path>C:\inetpub\DASHBOARD_DEPLOYMENT\Logs</log_path>
		<log_level>DEBUG</log_level>
		<log_filename>ComponentsMonitoring</log_filename>
		<mutex_name>ComponentsMonitoring</mutex_name>
		<application_name>ComponentsMonitoring</application_name>
		<!--<smtp_host>smtpconnectstring.manila.dg3.local</smtp_host>-->
		<!--<smtp_host>USNJMANILA01 </smtp_host>-->
		<smtp_host>192.168.250.94</smtp_host>
		<smtp_port>25</smtp_port>
		<send_emails>true</send_emails>
		<error_mailfrom>DEV-Dashboard-Site@dg3.com</error_mailfrom>
		<error_mailto>Billy.Gudian@dg3.com</error_mailto>
		<error_mail_level>ERROR</error_mail_level>
	</Dg3.CommonLibraries.LogWriter>
	<appSettings>
		<!-- SERVICE SETTINGS -->
		<add key="days_silence_duration" value="7" />
		<add key="region" value="DEV" />
	</appSettings>
	<connectionStrings>
		<!--<add name="database" connectionString="Data Source=localhost; Initial Catalog=component_monitoring;Integrated Security=True;" />-->
		<add name="database" connectionString="Data Source=PHMANGDEV03; Initial Catalog=component_monitoring; User ID=sa; Password=password;" />
		<!--<add name="database" connectionString="Data Source=127.0.0.1; Initial Catalog=component_monitoring; Trusted_Connection=true;"/>-->
		<!--<add name="database" connectionString="Data Source=PHMAN-TECHDEV15; Initial Catalog=component_monitoring; Integrated Security=True;" />-->
	</connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>