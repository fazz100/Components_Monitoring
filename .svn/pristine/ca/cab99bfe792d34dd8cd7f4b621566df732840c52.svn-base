<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="Dg3.CommonLibraries.LogWriter" type="Dg3.CommonLibraries.LogWriterConfigReader,Dg3.CommonLibraries.LogWriter" />
	</configSections>
	<!-- LOG WRITER -->
	<Dg3.CommonLibraries.LogWriter>
		<log_path>D:\Data\ComponentsMonitoring\Logs</log_path>
		<log_level>DEBUG</log_level>
		<log_filename>ComponentsMonitoringExceptionsUpdater</log_filename>
		<mutex_name>ComponentsMonitoringExceptionsUpdater</mutex_name>
		<application_name>ComponentsMonitoringExceptionsUpdater</application_name>
		<smtp_host>10.2.2.197</smtp_host>
		<smtp_port>25</smtp_port>
		<send_emails>true</send_emails>
		<error_mailfrom>Dg3.ComponentsMonitoring@dg3.com</error_mailfrom>
		<error_mailto>Julian.Skinner@dg3.com,Billy.Gudian@dg3.com</error_mailto>
		<error_mail_level>ERROR</error_mail_level>
	</Dg3.CommonLibraries.LogWriter>
	<appSettings>
		<!-- EMAIL SETTINGS -->
		<add key="mail_from" value="Dg3.ComponentsMonitoring@dg3.com" />
		<add key="mail_to" value="Julian.Skinner@dg3.com" />
		<add key="mail_cc" value="" />
		<add key="mail_bcc" value="Billy.Gudian@dg3.com" />
		<add key="smtp_host" value="10.2.2.197" />
		<add key="smtp_port" value="25" />
		<add key="smtp_username" value="" />
		<add key="smtp_password" value="" />
		<add key="command_timeout" value="3600" />
		<add key="send_email" value="true" />
		<add key="days_silence_duration" value="7" />
		<add key="region" value="PROD" />
	</appSettings>
	<connectionStrings>
		<add name="database" connectionString="Data Source=192.168.190.100; Initial Catalog=component_monitoring; Integrated Security=True;" />
	</connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>