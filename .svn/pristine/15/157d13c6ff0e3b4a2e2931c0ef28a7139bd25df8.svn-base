using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ModelsLibrary.Models.CustomExceptions
{
   [Serializable]
   public class InvalidWebsiteUrlException : Exception
   {
      public InvalidWebsiteUrlException() { }

      public InvalidWebsiteUrlException(string message)
          : base(message) { }

      public InvalidWebsiteUrlException(string message, Exception inner)
          : base(message, inner) { }
   }
}
