<configuration>
  <configSections>
    <section name="Dg3.CommonLibraries.LogWriter" type="Dg3.CommonLibraries.LogWriterConfigReader,Dg3.CommonLibraries.LogWriter" />
  </configSections>
  <!-- LOG WRITER -->
  <Dg3.CommonLibraries.LogWriter>
    <log_path>c:\Logs\Dg3.ComponentsMonitoring</log_path>
    <log_filename>Dg3.ComponentsMonitoring.ComponentsMonitoringAPI</log_filename>
    <mutex_name>Dg3.ComponentsMonitoring.ComponentsMonitoringAPI</mutex_name>
    <log_level>INFO</log_level>
    <application_name>Dg3.ComponentsMonitoring.ComponentsMonitoringAPI</application_name>
    <smtp_host>192.168.250.94</smtp_host>
    <smtp_port>25</smtp_port>
    <send_emails>true</send_emails>
    <error_mailfrom>DEV-Dg3.ComponentsMonitoring.ComponentsMonitoringAPI@dg3.com</error_mailfrom>
    <error_mailto>Billy.Gudian@dg3.com</error_mailto>
    <error_mail_level>ERROR</error_mail_level>
  </Dg3.CommonLibraries.LogWriter>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
	  <add key="SessionExpiryInSeconds" value="600" /><!--10 minutes-->
    <add key="reactAppUrl" value="http://localhost:5173" />
    <add key="encrypted_pepper" value="" />
  </appSettings>
  <connectionStrings>
    <add name="database" connectionString="Data Source=localhost; Initial Catalog=component_monitoring;Integrated Security=True;" />
    <!--<add name="database" connectionString="Data Source=PHMANGDEV03; Initial Catalog=dashboard; User ID=sa; Password=password;" />-->
    <!--<add name="monarch_database" connectionString="Data Source=MONARCH01-DEV.manila.dg3.local; Initial Catalog=gams1; Trusted_connection=true" />-->
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
