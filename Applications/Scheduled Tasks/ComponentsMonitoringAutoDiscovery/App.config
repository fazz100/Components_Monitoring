<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="Dg3.CommonLibraries.LogWriter" type="Dg3.CommonLibraries.LogWriterConfigReader,Dg3.CommonLibraries.LogWriter" />
	</configSections>
	<!-- LOG WRITER -->
	<Dg3.CommonLibraries.LogWriter>
		<log_path>C:\inetpub\DASHBOARD_DEPLOYMENT\Logs</log_path>
		<log_level>DEBUG</log_level>
		<log_filename>ComponentsMonitoringAutoDiscovery</log_filename>
		<mutex_name>ComponentsMonitoringAutoDiscovery</mutex_name>
		<application_name>ComponentsMonitoringAutoDiscovery</application_name>
		<smtp_host>192.168.250.94</smtp_host>
		<smtp_port>25</smtp_port>
		<send_emails>true</send_emails>
		<error_mailfrom>DEV-Dashboard-Site@dg3.com</error_mailfrom>
		<error_mailto>Billy.Gudian@dg3.com</error_mailto>
		<error_mail_level>ERROR</error_mail_level>
	</Dg3.CommonLibraries.LogWriter>
	<appSettings>
		<!-- SERVICE SETTINGS -->
		<!-- Comma-separated list of target servers/hosts to scan -->
		<add key="target_servers" value="wwwpw01.us.dg3.local,apppw01.us.dg3.local" />
		<!-- stored in applications.created_by for auto-discovered components -->
		<add key="created_by" value="AutoDiscovery" />
	</appSettings>
	<connectionStrings>
		<add name="database" connectionString="Data Source=PHMANGDEV03; Initial Catalog=component_monitoring; User ID=sa; Password=password;" providerName="System.Data.SqlClient" />
	</connectionStrings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
