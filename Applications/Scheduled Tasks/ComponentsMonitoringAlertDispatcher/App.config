<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="Dg3.CommonLibraries.LogWriter" type="Dg3.CommonLibraries.LogWriterConfigReader,Dg3.CommonLibraries.LogWriter" />
	</configSections>
	<!-- LOG WRITER -->
	<Dg3.CommonLibraries.LogWriter>
		<log_path>C:\inetpub\DASHBOARD_DEPLOYMENT\Logs</log_path>
		<log_level>DEBUG</log_level>
		<log_filename>ComponentsMonitoringAlertDispatcher</log_filename>
		<mutex_name>ComponentsMonitoringAlertDispatcher</mutex_name>
		<application_name>ComponentsMonitoringAlertDispatcher</application_name>
		<smtp_host>192.168.250.94</smtp_host>
		<smtp_port>25</smtp_port>
		<send_emails>true</send_emails>
		<error_mailfrom>DEV-Dashboard-Site@dg3.com</error_mailfrom>
		<error_mailto>Billy.Gudian@dg3.com</error_mailto>
		<error_mail_level>ERROR</error_mail_level>
	</Dg3.CommonLibraries.LogWriter>
	<appSettings>
		<!-- SERVICE SETTINGS -->
		<!-- minutes to wait after a failure is first detected, so other failures in the same group go out in the same digest -->
		<add key="grace_period_minutes" value="2" />
		<add key="region" value="DEV" />
		<!-- EMAIL SETTINGS -->
		<add key="mail_from" value="DEV-Dg3.ComponentsMonitoring@dg3.com" />
		<add key="mail_to" value="Billy.Gudian@dg3.com" />
		<add key="mail_cc" value="" />
		<add key="mail_bcc" value="Billy.Gudian@dg3.com,Michelle.Manapat@dg3.com" />
		<add key="smtp_host" value="192.168.250.94" />
		<add key="smtp_port" value="25" />
		<add key="smtp_username" value="" />
		<add key="smtp_password" value="" />
	</appSettings>
	<connectionStrings>
		<add name="database" connectionString="Data Source=PHMANGDEV03; Initial Catalog=component_monitoring; User ID=sa; Password=password;" />
	</connectionStrings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
